# Скопируйте в .env и заполните. Файл .env в git не попадает.

# База данных. Если не задана — SQLite в data/jobs.db в корне проекта
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/jobs

# polza.ai — OpenAI-совместимый агрегатор нейросетей (https://polza.ai/docs)
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1/
# Оценка вакансий и сопроводительные письма (~0,04 ₽ за оценку, ~0,08 ₽ за письмо)
LLM_MODEL_FAST=deepseek/deepseek-v4.1-flash
# Разбор резюме в профиль (разово, ~0,15 ₽)
LLM_MODEL_SMART=anthropic/claude-haiku-5.5
EMBEDDING_MODEL=baai/bge-m3

# Exa — модуль «Разведка» (необязательно)
EXA_API_KEY=

# Регион по умолчанию для «Работы России» (Пермский край)
DEFAULT_REGION_CODE=5900000000000

# --- Веб-доступ (на сервере обязательно) ---
# Пароль владельца. Пусто — вход не нужен (только для локального запуска!)
APP_PASSWORD=
# Секрет подписи cookie, минимум 32 символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Гостям без входа показывать демо на вымышленных данных
DEMO_ENABLED=true
DEMO_RESET_HOURS=6

# Домен для HTTPS (Caddy сам получит сертификат). Без своего домена подойдёт
# бесплатный вида 203-0-113-7.sslip.io — где 203.0.113.7 замените на IP сервера через дефисы
DOMAIN=

# --- Регистрация пользователей (работает при включённом входе: APP_PASSWORD и SESSION_SECRET) ---
REGISTRATION_ENABLED=true
# Адрес сайта: из него строятся ссылки в письмах и адреса возврата после входа через Яндекс/VK
PUBLIC_URL=http://localhost:8000
# Яндекс ID: https://oauth.yandex.ru/client/new, Redirect URI: <PUBLIC_URL>/api/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID: https://id.vk.ru/about/business, Redirect URL: <PUBLIC_URL>/api/auth/oauth/vk/callback
VK_CLIENT_ID=
# Почта для писем (подтверждение, сброс пароля). Пусто — письма пишутся в журнал сервера.
# Яндекс Почта: smtp.yandex.ru, порт 465, пароль — «пароль приложения» из настроек Яндекс ID
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Платных действий пользователя в день (у владельца лимитов нет)
LIMIT_REFRESH=1
LIMIT_LETTER=5
LIMIT_RESUME=2
LIMIT_CAREERS=2
LIMIT_ADVICE=1
LIMIT_MANUAL=10
MAX_PARALLEL_SEARCHES=2
