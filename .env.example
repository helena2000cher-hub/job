# Скопируйте в .env и заполните. Файл .env в git не попадает.

# База данных. Если не задана — SQLite в data/jobs.db в корне проекта
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/jobs

# polza.ai — OpenAI-совместимый агрегатор нейросетей (https://polza.ai/docs)
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1/
# Быстрая дешёвая модель для массовой оценки вакансий
LLM_MODEL_FAST=anthropic/claude-haiku-5.5
# Сильная модель для разбора резюме и сопроводительных писем
LLM_MODEL_SMART=anthropic/claude-sonnet-5.5
EMBEDDING_MODEL=baai/bge-m3

# Exa — модуль «Разведка» (необязательно)
EXA_API_KEY=

# Регион по умолчанию для «Работы России» (Пермский край)
DEFAULT_REGION_CODE=5900000000000
